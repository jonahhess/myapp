# Production-like smoke testing
# Copy to .env and set real values before running:
# npm run test:smoke:prod

PROD_API_BASE_URL=https://api.webify.host

# Required account for login + profile read
# Credential rules from app validation:
# - Email: valid email format
# - Password: max 8 chars, at least 1 uppercase, 1 lowercase, 1 special char,
#   and at lease 4 digits
SMOKE_USER_EMAIL=smoke.user@webify.host
SMOKE_USER_PASSWORD=Abc!1234

# Optional admin account for /users list smoke check
SMOKE_ADMIN_EMAIL=israel@gmail.com
SMOKE_ADMIN_PASSWORD=Abc!1234

# Optional recruiter account for recruiter flows smoke suite
SMOKE_RECRUITER_EMAIL=recruiter@recuiters.net
SMOKE_RECRUITER_PASSWORD=Abc!1234

# Optional non-admin account to verify /users is denied (401/403)
SMOKE_NON_ADMIN_EMAIL=smoke.user@webify.host
SMOKE_NON_ADMIN_PASSWORD=Abc!1234

# Request pacing controls
SMOKE_REQUEST_GAP_MS=1200
SMOKE_MAX_429_RETRIES=2

# Optional mutation smoke (no-op profile update)
RUN_PROD_MUTATION_SMOKE=false

# Optional recruiter mutation smoke (create + cleanup delete)
RUN_PROD_RECRUITER_MUTATION_SMOKE=false
