{
  "name": "myapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:integration:admin": "vitest run tests/integration/pages/AdminDashboard.test.jsx",
    "test:integration:recruiter": "vitest run tests/integration/pages/MyJobs.test.jsx",
    "test:smoke:prod": "RUN_PROD_SMOKE=true vitest run tests/smoke/prod.api.smoke.test.js --maxWorkers=1",
    "test:smoke:prod:mutations": "RUN_PROD_SMOKE=true RUN_PROD_MUTATION_SMOKE=true vitest run tests/smoke/prod.api.smoke.test.js --maxWorkers=1",
    "test:smoke:prod:admin": "RUN_PROD_ADMIN_SMOKE=true vitest run tests/smoke/prod.admin.api.smoke.test.js --maxWorkers=1",
    "test:smoke:prod:recruiter": "RUN_PROD_RECRUITER_SMOKE=true vitest run tests/smoke/prod.recruiter.api.smoke.test.js --maxWorkers=1"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "formik": "^2.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "react-toastify": "^11.1.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
